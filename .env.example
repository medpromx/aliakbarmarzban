# Endpoint that receives consultation requests as a JSON POST.
# Works with Formspree (https://formspree.io/f/xxxx) or Web3Forms (https://api.web3forms.com/submit).
PUBLIC_FORM_ENDPOINT=
# Web3Forms only: the access key for your form.
PUBLIC_FORM_ACCESS_KEY=
# Fallback address used for a mailto: hand-off when no endpoint is configured.
PUBLIC_CONTACT_EMAIL=
# Optional privacy-friendly analytics (Plausible). Leave empty to disable analytics.
PUBLIC_PLAUSIBLE_DOMAIN=
