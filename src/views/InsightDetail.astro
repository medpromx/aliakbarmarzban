---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import type { Insight } from '../lib/insights';
import { getService } from '../data/services';
import { site, ui } from '../data/site';
import { formatDate, href, t, type Lang, makeTr } from '../lib/i18n';
import { articleLd } from '../lib/schema';
interface Props { lang: Lang; insight: Insight }
const { lang, insight } = Astro.props;
const fa = lang === 'fa';
const tr = makeTr(lang);
const service = insight.service ? getService(insight.service) : undefined;
const { Content } = insight;
---
<Base lang={lang} title={insight.title} description={insight.summary} ogType="article" jsonLd={articleLd(lang, insight)}>
  <PageHero lang={lang} eyebrow={service ? t(service.title, lang) : t(ui.insights, lang)} title={insight.title} lead={insight.summary} crumbs={[{ label: t(ui.insights, lang), path: '/insights/' }, { label: insight.title }]}>
    <p class="byline">{t(site.advisorName, lang)} · <time datetime={insight.date}>{formatDate(insight.date, lang)}</time></p>
  </PageHero>
  <article class="section section--white">
    <div class="container">
      <div class="prose"><Content /></div>
      {service && (
        <aside class="related-service">
          <p class="eyebrow">{tr('خدمت مرتبط', 'Related advisory service')}</p>
          <h2><a href={href(lang, `/services/${service.slug}/`)}>{t(service.title, lang)}</a></h2>
          <p>{t(service.short, lang)}</p>
        </aside>
      )}
    </div>
  </article>
  <CtaBand lang={lang} title={service ? t(service.cta, lang) : t(ui.requestConsultation, lang)} text={tr('درباره پیامدهای این موضوع برای سازمان خود گفت‌وگو کنید.', 'Discuss what this means for your organisation.')} cta={service ? t(service.cta, lang) : t(ui.requestConsultation, lang)} service={service?.slug} track={`insight-${insight.slug}`} />
</Base>
<style>
  .byline { margin-block-start: 1.5rem; font-size: 0.92rem; color: var(--gold); }
  .prose { font-size: 1.08rem; }
  .related-service { max-width: 44rem; margin-block-start: 3.5rem; padding-block-start: 2rem; border-block-start: 1px solid var(--line); }
  .related-service h2 { font-size: 1.4rem; }
</style>
