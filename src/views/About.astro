---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site, ui, whatsappLink } from '../data/site';
import { differentiators } from '../data/common';
import { bio, stats } from '../data/profile';
import { href, t, type Lang, makeTr } from '../lib/i18n';
import { profilePageLd } from '../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fa = lang === 'fa';
const tr = makeTr(lang);
const title = tr('درباره مشاور', 'About the Advisor');
---
<Base lang={lang} title={title} ogType="profile" jsonLd={profilePageLd(lang)} description={t(site.description, lang)}>
  <PageHero
    lang={lang}
    eyebrow={title}
    title={t(site.advisorName, lang)}
    lead={t(site.title, lang)}
    crumbs={[{ label: title }]}
  />
  <section class="section section--white">
    <div class="container split">
      <figure class="portrait">
        <img src={site.portrait} alt={t(site.advisorName, lang)} width="640" height="800" loading="eager" />
        <figcaption>
          <strong>{t(site.advisorName, lang)}</strong>
          <span>{tr('مشاور امور دریایی، بندری و بین‌المللی', 'Maritime, port and international affairs advisor')}</span>
        </figcaption>
      </figure>
      <div class="prose">
        <h2>{tr('سی سال در بنادر و دریانوردی', 'Thirty years in ports and maritime affairs')}</h2>
        {t(bio, lang).map((p) => <p>{p}</p>)}
        <div class="btn-row about-ctas">
          <a class="btn btn--teal" href={href(lang, '/consultation/')} data-track="about-consult">{t(ui.requestConsultation, lang)} <Icon name="arrow" size={18} /></a>
          <a class="btn btn--outline" href={href(lang, '/experience/')}>{tr('سوابق کامل', 'Full experience')}</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section section--navy">
    <div class="container">
      <ul class="stats">
        {stats.map((s) => <li><strong>{t(s.value, lang)}</strong><span>{t(s.label, lang)}</span></li>)}
      </ul>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head"><p class="eyebrow">{tr('شیوه کار', 'How he works')}</p><h2>{tr('آنچه در همکاری انتظار دارید', 'What to expect when you work together')}</h2></div>
      <div class="grid grid--4">
        {differentiators.map((d) => <div class="card"><div class="icon-badge"><Icon name={d.icon} /></div><h3>{t(d.title, lang)}</h3><p>{t(d.text, lang)}</p></div>)}
      </div>
      <p class="wa-line">
        {tr('برای گفت‌وگوی مستقیم:', 'To talk directly:')}{' '}
        <a href={whatsappLink()} target="_blank" rel="noopener" data-track="whatsapp-about"><Icon name="whatsapp" size={18} /> {t(ui.whatsappShort, lang)} <span class="ltr">{site.whatsappDisplay}</span></a>
      </p>
    </div>
  </section>
  <CtaBand lang={lang} title={tr('گفت‌وگو را آغاز کنید', 'Start the conversation')} text={tr('مسئله سازمان خود را به‌اختصار بنویسید؛ پاسخ از طریق واتس‌اپ داده می‌شود.', "Briefly describe your organisation's challenge; you'll get a reply on WhatsApp.")} cta={t(ui.primaryCta, lang)} track="about-final" />
</Base>
<style>
  .portrait { margin: 0; }
  .portrait img { inline-size: 100%; block-size: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius); }
  .portrait figcaption { display: grid; gap: 0.1rem; margin-block-start: 0.9rem; padding-inline-start: 0.9rem; border-inline-start: 2px solid var(--gold); }
  .portrait figcaption strong { color: var(--navy); }
  .portrait figcaption span { font-size: 0.92rem; color: var(--slate-2); }
  @media (min-width: 900px) { .portrait { position: sticky; inset-block-start: 110px; align-self: start; } }
  .about-ctas { margin-block-start: 2rem; }
  .stats { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  .stats li { display: grid; gap: 0.4rem; border-block-start: 1px solid rgb(255 255 255 / 18%); padding-block-start: 1.2rem; }
  .stats strong { font-size: clamp(2.2rem, 4vw, 3rem); color: var(--gold); line-height: 1; }
  .stats span { color: #c9d5df; }
  .wa-line { margin-block-start: 2.5rem; }
  .wa-line a { display: inline-flex; gap: 0.4rem; align-items: center; font-weight: 700; }
  .wa-line :global(svg) { color: #1c9c4c; }
</style>
