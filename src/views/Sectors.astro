---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import JourneySelector from '../components/JourneySelector.astro';
import CtaBand from '../components/CtaBand.astro';
import { sectors } from '../data/sectors';
import { getService } from '../data/services';
import { ui } from '../data/site';
import { href, t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fa = lang === 'fa';
const title = fa ? 'مشتریان و بخش‌ها' : 'Clients & Sectors';
---
<Base lang={lang} title={title} description={fa ? 'مسیرهای اختصاصی برای دولت‌ها، سازمان‌های بنادر، مدیران حقوقی، کشتیرانی‌ها و مؤسسات آموزش دریایی.' : 'Dedicated paths for governments, port authorities, legal directors, shipowners and maritime training institutions.'}>
  <PageHero
    lang={lang}
    eyebrow={title}
    title={fa ? 'مسیر شما، متناسب با نقش سازمانی‌تان' : 'Your path, designed around your role'}
    lead={fa ? 'از بخش یا نقش خود آغاز کنید و مستقیم به خدمت مرتبط با مسئله‌تان برسید.' : 'Start from your sector or role and go straight to the practice that matches your challenge.'}
    crumbs={[{ label: title }]}
  />
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{fa ? 'مسیرهای پیشنهادی' : 'Recommended journeys'}</p>
        <h2>{fa ? 'نقش خود را انتخاب کنید' : 'Choose your role'}</h2>
      </div>
      <JourneySelector lang={lang} id="sector-journeys" />
    </div>
  </section>
  <section class="section section--white">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{fa ? 'بخش‌ها' : 'Sectors'}</p>
        <h2>{fa ? 'با چه سازمان‌هایی کار می‌کنیم' : 'Organisations we work with'}</h2>
      </div>
      <div class="grid grid--3">
        {sectors.map((sec) => (
          <article class="card">
            <h3>{t(sec.title, lang)}</h3>
            <p>{t(sec.text, lang)}</p>
            <ul class="sector-links">
              {sec.services.map((slug) => {
                const s = getService(slug)!;
                return <li><a href={href(lang, `/services/${slug}/`)}>{t(s.title, lang)}</a></li>;
              })}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>
  <CtaBand lang={lang} title={fa ? 'سازمان شما در این فهرست نیست؟' : "Don't see your organisation here?"} text={fa ? 'مسئله خود را شرح دهید؛ مشخص می‌کنیم آیا و چگونه می‌توانیم کمک کنیم.' : 'Describe your challenge and we will tell you whether and how we can help.'} cta={t(ui.requestConsultation, lang)} track="sectors-final" />
</Base>
<style>
  .sector-links { list-style: none; margin: 1rem 0 0; padding: 1rem 0 0; border-block-start: 1px solid var(--line); display: grid; gap: 0.4rem; font-size: 0.93rem; }
</style>
