---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { t, type Lang, makeTr } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fa = lang === 'fa';
const tr = makeTr(lang);
const title = tr('سیاست حریم خصوصی', 'Privacy Policy');
---
<Base lang={lang} title={title} description={tr('نحوه استفاده از اطلاعاتی که از طریق این وب‌سایت ارسال می‌کنید.', 'How information you send through this website is used.')}>
  <PageHero lang={lang} eyebrow={tr('حقوقی', 'Legal')} title={title} crumbs={[{ label: title }]} />
  <section class="section section--white">
    <div class="container">
      <div class="prose">
        <h2>{tr('چه اطلاعاتی دریافت می‌شود', 'What we receive')}</h2>
        <p>{tr('فرم درخواست مشاوره اطلاعاتی را که وارد می‌کنید (نام، سازمان، سمت، ایمیل، حوزه مشاوره، زمان‌بندی و شرح کوتاه موضوع) به‌صورت یک پیام آماده در واتس‌اپ شما قرار می‌دهد. اطلاعات تنها زمانی ارسال می‌شود که خودتان پیام را در واتس‌اپ بفرستید. این وب‌سایت فرم را روی هیچ سروری ذخیره نمی‌کند.', 'The consultation form turns the details you enter (name, organisation, position, email, advisory area, timeframe and a short description) into a ready-to-send WhatsApp message. Nothing is sent until you send that message yourself, and the website does not store the form on any server.')}</p>
        <h2>{tr('استفاده از اطلاعات', 'How it is used')}</h2>
        <p>{tr('اطلاعات شما فقط برای پاسخ به درخواست، هماهنگی جلسه و بررسی همکاری استفاده می‌شود، محرمانه می‌ماند و در اختیار دیگران قرار نمی‌گیرد.', 'Your information is used only to reply to your request, arrange a conversation and consider working together. It is kept confidential and not shared with anyone else.')}</p>
        <h2>{tr('مدت نگهداری', 'How long it is kept')}</h2>
        <p>{tr('پیام‌ها تا زمانی نگهداری می‌شوند که برای پیگیری درخواست و همکاری لازم باشند. هر زمان بخواهید، با یک پیام حذف آنها را درخواست کنید.', 'Messages are kept only as long as needed to follow up your request and any engagement. You can ask for them to be deleted at any time.')}</p>
        <h2>{tr('آمار بازدید و کوکی‌ها', 'Statistics and cookies')}</h2>
        <p>{tr('این وب‌سایت از کوکی‌های تبلیغاتی یا ردیابی استفاده نمی‌کند. در صورت فعال‌بودن آمار بازدید، از ابزاری بدون کوکی استفاده می‌شود که اطلاعات شخصی جمع نمی‌کند.', 'This website uses no advertising or tracking cookies. If visitor statistics are enabled, a cookieless tool that collects no personal data is used.')}</p>
        <h2>{tr('تماس', 'Contact')}</h2>
        <p>{tr('علی‌اکبر مرزبان، واتس‌اپ', 'Ali Akbar Marzban, WhatsApp')} <span class="ltr">{site.whatsappDisplay}</span></p>
      </div>
    </div>
  </section>
</Base>
