---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { t, type Lang, makeTr } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fa = lang === 'fa';
const tr = makeTr(lang);
const title = tr('اطلاعیه‌های حقوقی', 'Legal Notices');
---
<Base lang={lang} title={title}>
  <PageHero lang={lang} eyebrow={tr('حقوقی', 'Legal')} title={title} crumbs={[{ label: title }]} />
  <section class="section section--white">
    <div class="container">
      <div class="prose">
        <h2>{tr('صاحب وب‌سایت', 'Website owner')}</h2>
        <p>{tr('این وب‌سایت متعلق به علی‌اکبر مرزبان است.', 'This website belongs to Ali Akbar Marzban.')}</p>
        <p>{tr('راه ارتباطی: واتس‌اپ', 'Contact: WhatsApp')} <span class="ltr">{site.whatsappDisplay}</span></p>
        <h2>{tr('محتوای اطلاعاتی', 'Information')}</h2>
        <p>{tr('مطالب تحلیلی این وب‌سایت برای آگاهی عمومی نوشته شده‌اند. برای بررسی وضعیت خاص سازمان خود، درخواست مشاوره ثبت کنید.', 'Insights on this website are written for general information. To discuss your organisation\'s specific situation, request a consultation.')}</p>
        <h2>{tr('مالکیت معنوی', 'Intellectual property')}</h2>
        <p>{tr('کلیه متن‌ها و تصاویر این وب‌سایت متعلق به صاحب وب‌سایت است و استفاده از آنها تنها با ذکر منبع مجاز است.', 'All text and images on this website belong to the website owner and may be quoted only with attribution.')}</p>
      </div>
    </div>
  </section>
</Base>
