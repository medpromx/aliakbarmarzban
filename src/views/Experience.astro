---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import credentials from '../data/credentials.json';
import { stats } from '../data/profile';
import { ui } from '../data/site';
import { t, type Lang, type L } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fa = lang === 'fa';
const title = fa ? 'سوابق و اعتبارنامه‌ها' : 'Experience & Credentials';
const tx = (v: unknown) => t(v as L, lang);
---
<Base lang={lang} title={title} description={fa ? 'سوابق شغلی، نقش‌های بین‌المللی، تحصیلات و کتاب‌های علی‌اکبر مرزبان.' : 'Career, international roles, education and books of Ali Akbar Marzban.'}>
  <PageHero
    lang={lang}
    eyebrow={title}
    title={fa ? 'از بندر امام خمینی تا مقر IMO در لندن' : 'From Imam Khomeini Port to the IMO in London'}
    lead={fa ? 'سه دهه کار حقوقی، مدیریتی و بین‌المللی در بنادر و دریانوردی.' : 'Three decades of legal, executive and international work in ports and maritime affairs.'}
    crumbs={[{ label: title }]}
  />
  <section class="section section--navy stats-band">
    <div class="container">
      <ul class="stats">
        {stats.map((s) => <li><strong>{t(s.value, lang)}</strong><span>{t(s.label, lang)}</span></li>)}
      </ul>
    </div>
  </section>
  <section class="section section--white">
    <div class="container">
      <div class="cred-groups">
        {credentials.groups.map((g) => (
          <section class="cred-group" aria-labelledby={`g-${g.id}`}>
            <h2 id={`g-${g.id}`}>{tx(g.title)}</h2>
            <ol class="timeline">
              {g.items.map((it) => (
                <li class="timeline__item">
                  <span class="timeline__period">{tx(it.period)}</span>
                  <div>
                    <h3>{tx(it.title)}</h3>
                    <p>{tx(it.org)}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container grid grid--2">
      <div class="card">
        <h2>{fa ? 'سخنرانی و حضور بین‌المللی' : 'Speaking and international presence'}</h2>
        <p>{tx(credentials.speaking)}</p>
      </div>
      <div class="card">
        <h2>{fa ? 'رویدادها' : 'Events'}</h2>
        <p>{tx(credentials.events)}</p>
      </div>
    </div>
  </section>
  <CtaBand lang={lang} title={fa ? 'این تجربه را برای سازمان خود به کار بگیرید' : 'Put this experience to work for your organisation'} text={fa ? 'مسئله خود را بنویسید تا درباره مسیر همکاری گفت‌وگو کنیم.' : "Describe your challenge and let's discuss how to work together."} cta={t(ui.primaryCta, lang)} track="experience-final" />
</Base>
<style>
  .stats-band { padding-block: clamp(40px, 6vw, 72px); }
  .stats { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  .stats li { display: grid; gap: 0.4rem; }
  .stats strong { font-size: clamp(2.2rem, 4vw, 3rem); color: var(--gold); line-height: 1; }
  .stats span { color: #c9d5df; }
  .cred-groups { display: grid; gap: 3rem 4rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); }
  .cred-group h2 { font-size: 1.35rem; }
  .timeline { list-style: none; margin: 0; padding: 0; border-inline-start: 1px solid var(--line); }
  .timeline__item { position: relative; display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; padding-block-end: 1.6rem; padding-inline-start: 1.4rem; }
  .timeline__item::before { content: ''; position: absolute; inset-inline-start: -5px; inset-block-start: 0.55rem; inline-size: 9px; block-size: 9px; border-radius: 50%; background: var(--teal); }
  .timeline__period { font-size: 0.88rem; font-weight: 700; color: var(--gold-dark); padding-block-start: 0.2rem; }
  .timeline__item h3 { font-size: 1.05rem; margin: 0 0 0.2rem; }
  .timeline__item p { margin: 0; font-size: 0.95rem; }
  @media (max-width: 520px) { .timeline__item { grid-template-columns: 1fr; gap: 0.2rem; } }
  .card h2 { font-size: 1.25rem; }
</style>
