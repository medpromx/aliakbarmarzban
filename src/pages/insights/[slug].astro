---
import View from '../../views/InsightDetail.astro';
import { getInsights } from '../../lib/insights';
export function getStaticPaths() {
  return getInsights('en').map((insight) => ({ params: { slug: insight.slug }, props: { insight } }));
}
const { insight } = Astro.props;
---
<View lang="en" insight={insight} />
