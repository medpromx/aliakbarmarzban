---
import { otherLangs, type Lang } from '../../../lib/i18n';
import View from '../../../views/InsightDetail.astro';
import { getInsights } from '../../../lib/insights';
export function getStaticPaths() {
  return otherLangs.flatMap((lang) => getInsights(lang).map((insight) => ({ params: { lang, slug: insight.slug }, props: { insight } })));
}
const { insight } = Astro.props;
const lang = Astro.params.lang as Lang;
---
<View lang={lang} insight={insight} />
