---
import Redirect from '../../../components/Redirect.astro';
import { href, otherLangs, type Lang } from '../../../lib/i18n';
import { movedInsights } from '../../../lib/redirects';
export function getStaticPaths() {
  return otherLangs.flatMap((lang) => Object.entries(movedInsights).map(([slug, to]) => ({ params: { lang, slug }, props: { to: href(lang, to) } })));
}
---
<Redirect to={Astro.props.to} />
