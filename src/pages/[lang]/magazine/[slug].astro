---
import { otherLangs, type Lang } from '../../../lib/i18n';
import View from '../../../views/MagazineArticle.astro';
import { getArticles } from '../../../lib/magazine';
export function getStaticPaths() {
  return otherLangs.flatMap((lang) => getArticles(lang).map((article) => ({ params: { lang, slug: article.slug }, props: { article } })));
}
const { article } = Astro.props;
const lang = Astro.params.lang as Lang;
---
<View lang={lang} article={article} />
