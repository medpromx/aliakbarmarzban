---
import { otherLangs, type Lang } from '../../../../lib/i18n';
import View from '../../../../views/EncyclopediaEntry.astro';
import { getEntries } from '../../../../lib/encyclopedia';
export function getStaticPaths() {
  return otherLangs.flatMap((lang) => getEntries(lang).map((entry) => ({ params: { lang, category: entry.category, slug: entry.slug }, props: { entry } })));
}
const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
---
<View lang={lang} entry={entry} />
