---
import { otherLangs, type Lang } from '../../../../lib/i18n';
import View from '../../../../views/EncyclopediaCategory.astro';
import { categories } from '../../../../lib/encyclopedia';
export function getStaticPaths() {
  return otherLangs.flatMap((lang) => categories.map((category) => ({ params: { lang, category: category.key }, props: { category } })));
}
const { category } = Astro.props;
const lang = Astro.params.lang as Lang;
---
<View lang={lang} category={category} />
