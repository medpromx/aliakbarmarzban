---
import '@fontsource-variable/manrope';
import '@fontsource-variable/vazirmatn';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, ui } from '../data/site';
import { basePath, dir, href, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  ogType?: 'website' | 'article' | 'profile';
}
const { lang, title, description = t(site.description, lang), jsonLd, noindex = false, ogType = 'website' } = Astro.props;
const path = basePath(Astro.url.pathname);
const canonical = new URL(href(lang, path), site.url).href;
const fullTitle = path === '/' ? `${t(site.advisorName, lang)} — ${t(site.brand, lang)}` : `${title} | ${t(site.advisorName, lang)}`;
const plausible = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang={lang} dir={dir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(href('en', path), site.url).href} />
    <link rel="alternate" hreflang="fa" href={new URL(href('fa', path), site.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(href('en', path), site.url).href} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#10283e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t(site.brand, lang)} />
    <meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_GB'} />
    <meta name="twitter:card" content="summary" />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    {plausible && <script defer data-domain={plausible} src="https://plausible.io/js/script.js"></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">{t(ui.skip, lang)}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Privacy-conscious conversion events: sent only if Plausible is configured, no cookies.
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
        const w = window as any;
        if (el && typeof w.plausible === 'function') {
          w.plausible('CTA Click', { props: { cta: el.dataset.track, page: location.pathname } });
        }
      });
    </script>
  </body>
</html>
<style is:global>
  .skip-link {
    position: absolute;
    inset-inline-start: 1rem;
    inset-block-start: -100px;
    z-index: 100;
    background: var(--gold);
    color: var(--navy);
    padding: 0.7rem 1rem;
    font-weight: 700;
    border-radius: var(--radius);
  }
  .skip-link:focus { inset-block-start: 1rem; }
  main:focus { outline: none; }
</style>
