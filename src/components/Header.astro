---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { nav, site, ui } from '../data/site';
import { basePath, href, langMeta, langs, t, type Lang, makeTr } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const current = basePath(Astro.url.pathname);
const isActive = (path: string) => current.startsWith(path);
---
<header class="site-header">
  <div class="container container--wide site-header__inner">
    <a class="brand" href={href(lang, '/')}>
      <span class="brand__mark"><Logo size={42} /></span>
      <span class="brand__text">
        <span class="brand__name">{t(site.advisorName, lang)}</span>
        <span class="brand__tag">{t(site.brand, lang)}</span>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle__open"><Icon name="menu" /></span>
      <span class="nav-toggle__close"><Icon name="close" /></span>
      <span class="sr-only">{t(ui.menu, lang)}</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label={makeTr(lang)('منوی اصلی', 'Main')}>
      <ul>
        {nav.map((item) => (
          <li>
            <a href={href(lang, item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>{t(item.label, lang)}</a>
          </li>
        ))}
      </ul>
      <div class="site-nav__actions">
        <details class="lang-menu">
          <summary aria-label={makeTr(lang)('انتخاب زبان', 'Choose language')}>
            <Icon name="globe" size={18} /> <span class="lang-menu__code">{lang.toUpperCase()}</span><span class="lang-menu__name" lang={lang}>{langMeta[lang].name}</span>
          </summary>
          <ul>
            {langs.map((l) => (
              <li>
                <a href={href(l, current)} hreflang={l} lang={l} dir={langMeta[l].dir} aria-current={l === lang ? 'true' : undefined}>{langMeta[l].name}</a>
              </li>
            ))}
          </ul>
        </details>
        <a class="btn btn--primary btn--sm" href={href(lang, '/consultation/')} data-track="cta-header">{t(ui.requestConsultation, lang)}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const navEl = document.getElementById('site-nav');
  if (toggle && navEl) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('nav-open', open);
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { set(false); toggle.focus(); }
    });
    matchMedia('(min-width: 1280px)').addEventListener('change', (m) => m.matches && set(false));
  }
  // Close the language menu on outside click or Escape.
  const langMenu = document.querySelector<HTMLDetailsElement>('.lang-menu');
  if (langMenu) {
    document.addEventListener('click', (e) => { if (!langMenu.contains(e.target as Node)) langMenu.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && langMenu.open) { langMenu.open = false; langMenu.querySelector('summary')!.focus(); } });
  }
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: rgb(16 40 62 / 97%);
    color: var(--white);
    border-block-end: 1px solid rgb(255 255 255 / 8%);
  }
  /* backdrop-filter would trap the fixed mobile menu inside the header, so keep it to desktop. */
  @media (min-width: 1280px) { .site-header { backdrop-filter: saturate(140%) blur(8px); } }
  .container--wide { max-width: 1400px; }
  .site-header__inner { display: flex; align-items: center; gap: 1.5rem; min-height: 76px; }
  .brand { white-space: nowrap; flex-shrink: 0; display: flex; align-items: center; gap: 0.75rem; color: var(--white); text-decoration: none; margin-inline-end: auto; }
  .brand:hover { color: var(--white); }
  .brand__text { display: flex; flex-direction: column; line-height: 1.25; }
  .brand__name { font-weight: 700; font-size: 1.02rem; }
  .brand__tag { font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold); }
  :global(:root:is([dir='rtl'], [lang='zh'])) .brand__tag { letter-spacing: normal; font-size: 0.8rem; text-transform: none; }

  .site-nav { display: flex; align-items: center; gap: 1.5rem; }
  .site-nav > ul { list-style: none; display: flex; gap: 1.1rem; margin: 0; padding: 0; }
  .site-nav > ul a { white-space: nowrap; color: #d6dfe7; text-decoration: none; font-size: 0.92rem; font-weight: 500; padding-block: 0.4rem; border-block-end: 1px solid transparent; }
  .site-nav > ul a:hover { color: var(--white); border-color: rgb(213 175 120 / 60%); }
  .site-nav > ul a[aria-current='page'] { color: var(--white); border-color: var(--gold); }
  .site-nav__actions { white-space: nowrap; display: flex; align-items: center; gap: 1rem; }
  .brand__mark { color: var(--white); display: inline-flex; }
  .lang-menu { position: relative; }
  .lang-menu summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem; color: var(--white); font-size: 0.92rem; padding: 0.4rem 0.7rem; border: 1px solid rgb(255 255 255 / 25%); border-radius: var(--radius); min-height: 40px; }
  .lang-menu summary :global(svg) { flex-shrink: 0; }
  .lang-menu summary::-webkit-details-marker { display: none; }
  .lang-menu summary:hover, .lang-menu[open] summary { border-color: var(--gold); }
  .lang-menu ul { position: absolute; inset-block-start: calc(100% + 6px); inset-inline-end: 0; z-index: 70; list-style: none; margin: 0; padding: 0.4rem; min-inline-size: 170px; background: var(--white); border-radius: var(--radius); box-shadow: 0 10px 30px rgb(0 0 0 / 25%); }
  .lang-menu a { display: block; padding: 0.55rem 0.8rem; color: var(--navy); text-decoration: none; border-radius: 3px; font-size: 0.95rem; text-align: start; }
  .lang-menu a:hover { background: var(--off-white); }
  .lang-menu a[aria-current] { font-weight: 700; color: var(--teal-dark); }
  .lang-menu a:lang(fa), .lang-menu a:lang(ar) { font-family: var(--font-fa); }
  .lang-menu a:lang(zh) { font-family: var(--font-en), var(--font-zh); }
  .btn--sm { min-height: 42px; padding: 0.55rem 1rem; font-size: 0.9rem; }

  .nav-toggle { display: none; background: none; border: 1px solid rgb(255 255 255 / 25%); color: var(--white); border-radius: var(--radius); inline-size: 46px; block-size: 46px; place-items: center; cursor: pointer; }
  .nav-toggle__close { display: none; }

  @media (max-width: 1279px) {
    .nav-toggle { display: grid; }
    .site-nav {
      display: none;
      position: fixed;
      inset: 76px 0 0 0;
      background: var(--navy);
      flex-direction: column;
      align-items: stretch;
      padding: 1.5rem var(--gutter) 2rem;
      overflow-y: auto;
    }
    :global(.nav-open) .site-nav { display: flex; }
    :global(.nav-open) .nav-toggle__open { display: none; }
    :global(.nav-open) .nav-toggle__close { display: block; }
    :global(.nav-open) body { overflow: hidden; }
    .site-nav > ul { flex-direction: column; gap: 0; }
    .site-nav > ul a { display: block; padding-block: 0.95rem; font-size: 1.1rem; border-block-end: 1px solid rgb(255 255 255 / 10%); }
    .site-nav__actions { flex-direction: column; align-items: stretch; margin-block-start: 1.5rem; }
    .lang-menu summary { inline-size: 100%; justify-content: center; padding: 0.7rem; }
    .lang-menu summary .lang-menu__code { display: none; }
    .lang-menu summary .lang-menu__name { display: inline; }
    .lang-menu ul { position: static; margin-block-start: 0.5rem; box-shadow: none; }
  }
  .lang-menu__name { display: none; }
  .lang-menu__code { font-weight: 700; font-size: 0.85rem; letter-spacing: 0.04em; }
  @media (min-width: 1280px) and (max-width: 1499px) {
    .brand__tag { display: none; }
    .site-header__inner, .site-nav { gap: 1.1rem; }
    .site-nav > ul { gap: 0.95rem; }
  }
  @media (max-width: 420px) { .brand__tag { display: none; } }
</style>
