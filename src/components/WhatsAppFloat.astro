---
import Icon from './Icon.astro';
import { site, ui, whatsappLink } from '../data/site';
import { t, type Lang, makeTr } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const greeting = makeTr(lang)('سلام آقای مرزبان، از طریق وب‌سایت پیام می‌دهم.', 'Hello Mr Marzban, I am writing to you via your website.');
---
<a class="wa-float" href={whatsappLink(greeting)} target="_blank" rel="noopener" data-track="whatsapp-float" aria-label={`${t(ui.whatsapp, lang)} ${site.whatsappDisplay}`}>
  <Icon name="whatsapp" size={26} />
  <span class="wa-float__label">{t(ui.whatsappShort, lang)}</span>
</a>
<style>
  .wa-float {
    position: fixed;
    inset-block-end: 20px;
    inset-inline-end: 20px;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #25d366;
    color: #0b3d22;
    font-weight: 700;
    text-decoration: none;
    border-radius: 999px;
    padding: 0.7rem 1.1rem 0.7rem 0.9rem;
    box-shadow: 0 6px 20px rgb(0 0 0 / 22%);
  }
  .wa-float:hover { background: #1fbe5b; color: #0b3d22; }
  .wa-float:focus-visible { outline: 3px solid var(--navy); outline-offset: 3px; }
  @media (max-width: 600px) { .wa-float__label { display: none; } .wa-float { padding: 0.8rem; } }
  @media print { .wa-float { display: none; } }
</style>
