---
import SeaLines from './SeaLines.astro';
import { href, t, type Lang } from '../lib/i18n';
import { ui } from '../data/site';
interface Props {
  lang: Lang;
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: { label: string; path?: string }[];
}
const { lang, eyebrow, title, lead, crumbs = [] } = Astro.props;
const trail = [{ label: t(ui.home, lang), path: '/' }, ...crumbs];
---
<section class="page-hero">
  <SeaLines variant="band" />
  <div class="container">
    {crumbs.length > 0 && (
      <nav class="breadcrumb" aria-label={lang === 'fa' ? 'مسیر صفحه' : 'Breadcrumb'}>
        <ol>
          {trail.map((c, i) => (
            <li>
              {i < trail.length - 1 && c.path ? <a href={href(lang, c.path)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
