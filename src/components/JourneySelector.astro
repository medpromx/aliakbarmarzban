---
import Icon from './Icon.astro';
import { journeys } from '../data/sectors';
import { href, t, type Lang } from '../lib/i18n';
interface Props { lang: Lang; id?: string }
const { lang, id = 'journeys' } = Astro.props;
const L = {
  pick: { en: 'Select your role to see the recommended path', fa: 'نقش سازمانی خود را انتخاب کنید تا مسیر پیشنهادی نمایش داده شود' },
  need: { en: 'Primary need', fa: 'نیاز اصلی' },
  path: { en: 'Recommended path', fa: 'مسیر پیشنهادی' },
  next: { en: 'Next step', fa: 'اقدام بعدی' },
};
---
<div class="journey" data-journey>
  <p class="journey__pick" id={`${id}-label`}>{t(L.pick, lang)}</p>
  <div class="journey__tabs" role="tablist" aria-labelledby={`${id}-label`}>
    {journeys.map((j, i) => (
      <button
        type="button"
        role="tab"
        id={`${id}-tab-${j.id}`}
        aria-controls={`${id}-panel-${j.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
      >{t(j.audience, lang)}</button>
    ))}
  </div>
  {journeys.map((j, i) => (
    <div class="journey__panel" role="tabpanel" id={`${id}-panel-${j.id}`} aria-labelledby={`${id}-tab-${j.id}`} hidden={i !== 0} tabindex="0">
      <div class="journey__col">
        <h3 class="journey__h">{t(L.need, lang)}</h3>
        <p class="journey__need">{t(j.need, lang)}</p>
      </div>
      <div class="journey__col">
        <h3 class="journey__h">{t(L.path, lang)}</h3>
        <ol class="journey__steps">
          {j.steps.map((s) => <li>{s.path ? <a href={href(lang, s.path)}>{t(s.label, lang)}</a> : t(s.label, lang)}</li>)}
        </ol>
      </div>
      <div class="journey__col">
        <h3 class="journey__h">{t(L.next, lang)}</h3>
        <a class="btn btn--teal" href={`${href(lang, '/consultation/')}?service=${j.service}`} data-track={`journey-${j.id}`}>{t(j.cta, lang)} <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-journey]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (tab: HTMLButtonElement, focus = true) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab, false));
      tab.addEventListener('keydown', (e) => {
        const rtl = getComputedStyle(root).direction === 'rtl';
        const fwd = rtl ? 'ArrowLeft' : 'ArrowRight';
        const back = rtl ? 'ArrowRight' : 'ArrowLeft';
        let next = -1;
        if (e.key === fwd) next = (i + 1) % tabs.length;
        else if (e.key === back) next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next >= 0) { e.preventDefault(); select(tabs[next]); }
      });
    });
  });
</script>

<style>
  .journey { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); }
  .journey__pick { margin: 0; padding: 1.2rem clamp(18px, 2.6vw, 32px) 0; font-size: 0.95rem; color: var(--slate-2); }
  .journey__tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 1rem clamp(18px, 2.6vw, 32px); border-block-end: 1px solid var(--line); }
  .journey__tabs button {
    font: inherit;
    font-size: 0.93rem;
    font-weight: 600;
    color: var(--slate);
    background: var(--off-white);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.55rem 1rem;
    cursor: pointer;
    min-height: 44px;
  }
  .journey__tabs button:hover { border-color: var(--teal); }
  .journey__tabs button[aria-selected='true'] { background: var(--navy); color: var(--white); border-color: var(--navy); }
  .journey__panel { display: grid; gap: 1.8rem; padding: clamp(22px, 3vw, 36px); }
  .journey__panel[hidden] { display: none; }
  @media (min-width: 900px) { .journey__panel { grid-template-columns: 1fr 1.3fr 1fr; } }
  .journey__h { font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--teal); margin-block-end: 0.7rem; }
  :global(:root[lang='fa']) .journey__h { letter-spacing: normal; font-size: 0.9rem; }
  .journey__need { color: var(--navy); font-size: 1.1rem; font-weight: 600; margin: 0; }
  .journey__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; counter-reset: j; }
  .journey__steps li { counter-increment: j; display: flex; gap: 0.7rem; align-items: baseline; }
  .journey__steps li::before { content: counter(j); font-size: 0.78rem; font-weight: 700; color: var(--gold-dark); inline-size: 1.5rem; block-size: 1.5rem; border: 1px solid var(--gold); border-radius: 50%; display: inline-grid; place-items: center; flex: none; }
  :global(:root[lang='fa']) .journey__steps li::before { content: counter(j, persian); }
</style>
