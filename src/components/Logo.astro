---
// Brand mark: a cargo ship on the sea, drawn in fine lines to match the site's maritime motif.
interface Props { size?: number }
const { size = 40 } = Astro.props;
---
<svg class="logo" viewBox="0 0 48 48" width={size} height={size} aria-hidden="true" focusable="false">
  <circle cx="24" cy="24" r="23" fill="none" stroke="currentColor" stroke-opacity="0.35" stroke-width="1" />
  <!-- containers -->
  <g fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round">
    <rect x="11" y="21.5" width="5" height="4" />
    <rect x="16" y="21.5" width="5" height="4" />
    <rect x="21" y="21.5" width="5" height="4" />
    <rect x="13.5" y="17.5" width="5" height="4" />
    <rect x="18.5" y="17.5" width="5" height="4" />
    <!-- bridge and mast -->
    <path d="M29 25.5v-9h6v9M30.5 19h3M32 16.5v-4" />
  </g>
  <!-- hull -->
  <path d="M7 25.5h34l-4.2 5.5H11.5z" fill="currentColor" />
  <!-- sea -->
  <path d="M6 34.5c2.5-1.6 4.5-1.6 7 0s4.5 1.6 7 0 4.5-1.6 7 0 4.5 1.6 7 0 4.5-1.6 7 0" fill="none" stroke="#d5af78" stroke-width="1.3" stroke-linecap="round" />
  <path d="M10 38.5c2.3-1.4 4.2-1.4 6.5 0s4.2 1.4 6.5 0 4.2-1.4 6.5 0 4.2 1.4 6.5 0" fill="none" stroke="#d5af78" stroke-width="1.1" stroke-linecap="round" stroke-opacity="0.7" />
</svg>
