---
// Static redirect for a page that has moved (GitHub Pages cannot send a 301).
import { site } from '../data/site';
interface Props { to: string }
const { to } = Astro.props;
const url = new URL(to, site.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={url} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body><p><a href={to}>{url}</a></p></body>
</html>
