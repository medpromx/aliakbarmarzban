---
import Icon from './Icon.astro';
import type { Insight } from '../lib/insights';
import { getService } from '../data/services';
import { ui } from '../data/site';
import { formatDate, href, t, type Lang } from '../lib/i18n';
interface Props { lang: Lang; insight: Insight }
const { lang, insight } = Astro.props;
const service = insight.service ? getService(insight.service) : undefined;
---
<article class="card card--link insight-card">
  <p class="insight-card__meta">
    {service && <span class="tag">{t(service.title, lang)}</span>}
    <time datetime={insight.date}>{formatDate(insight.date, lang)}</time>
  </p>
  <h3><a class="stretched" href={href(lang, `/insights/${insight.slug}/`)}>{insight.title}</a></h3>
  <p>{insight.summary}</p>
  <span class="more" aria-hidden="true">{t(ui.readMore, lang)} <Icon name="arrow" size={16} /></span>
</article>
<style>
  .insight-card__meta { display: grid; gap: 0.2rem; font-size: 0.85rem; color: var(--slate-2); margin: 0 0 0.4rem !important; }
</style>
