---
import type { Lang } from '../lib/i18n';
interface Props { lang: Lang; label?: string }
const { lang, label } = Astro.props;
const heading = label ?? (lang === 'fa' ? 'محتوا در انتظار تأیید' : 'Pending verification');
---
<div class="placeholder" role="note">
  <strong>{heading}</strong>
  <slot />
</div>
